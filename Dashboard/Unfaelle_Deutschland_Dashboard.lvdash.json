{
  "datasets": [
    {
      "name": "5a5beaf1",
      "displayName": "unfaelle",
      "queryLines": [
        "SELECT jahr, monat, wochentag, wochentag_nr, stunde, bundesland,\r\n",
        "       COUNT(*)               AS unfaelle,\r\n",
        "       COUNT_IF(ist_toedlich) AS toedliche\r\n",
        "FROM unfaelle_silver\r\n",
        "GROUP BY ALL;"
      ],
      "columns": [
        {
          "displayName": "wochentag_kuerzel",
          "description": "Weekday abbreviations in German",
          "expression": "CASE wochentag_nr WHEN 1 THEN 'Mo' WHEN 2 THEN 'Di' WHEN 3 THEN 'Mi' WHEN 4 THEN 'Do' WHEN 5 THEN 'Fr' WHEN 6 THEN 'Sa' WHEN 7 THEN 'So' END"
        },
        {
          "displayName": "anteil_toedlich_pct",
          "description": "",
          "expression": "100.0 * SUM(toedliche) / SUM(unfaelle)"
        }
      ]
    },
    {
      "name": "352b393a",
      "displayName": "Verkehrsmittel",
      "queryLines": [
        "SELECT jahr, bundesland, verkehrsmittel, unfalltyp,\r\n",
        "       COUNT(*)               AS beteiligungen,\r\n",
        "       COUNT_IF(ist_toedlich) AS toedliche\r\n",
        "FROM unfaelle_beteiligte\r\n",
        "GROUP BY ALL;"
      ],
      "columns": [
        {
          "displayName": "toedliche_Beteiligung",
          "description": "",
          "expression": "100.0 * SUM(toedliche) / SUM(beteiligungen)"
        },
        {
          "displayName": "verkehrsmittel_kurz",
          "description": "Kurze Abkürzungen für Verkehrsmittel",
          "expression": "CASE verkehrsmittel WHEN 'PKW' THEN 'PKW' WHEN 'Fahrrad' THEN 'Rad' WHEN 'Güterkraftfahrzeug' THEN 'LKW' WHEN 'Sonstige' THEN 'Sonst' WHEN 'Motorrad' THEN 'Moto' WHEN 'Fußgänger' THEN 'Fuß' ELSE verkehrsmittel END"
        }
      ]
    },
    {
      "name": "e0f7c28a",
      "displayName": "Karte",
      "queryLines": [
        "SELECT jahr, bundesland, ROUND(lat,1) AS lat, ROUND(lon,1) AS lon,\r\n",
        "       COUNT(*)               AS unfaelle,\r\n",
        "       COUNT_IF(ist_toedlich) AS toedliche\r\n",
        "FROM unfaelle_silver\r\n",
        "WHERE lat BETWEEN 47 AND 56 AND lon BETWEEN 5 AND 16\r\n",
        "GROUP BY ALL\r\n",
        "HAVING COUNT(*) >= 5;"
      ]
    },
    {
      "name": "35e65262",
      "displayName": "Bundeslaender",
      "queryLines": [
        "SELECT\r\n",
        "  s.jahr,\r\n",
        "  s.bundesland,\r\n",
        "  e.einwohner,\r\n",
        "  COUNT(*)                 AS unfaelle,\r\n",
        "  COUNT_IF(s.ist_toedlich) AS toedliche\r\n",
        "FROM unfaelle_silver s\r\n",
        "JOIN bundesland_einwohner e ON s.bundesland = e.bundesland\r\n",
        "GROUP BY ALL;"
      ],
      "columns": [
        {
          "displayName": "Unfaelle verteilt auf Bundesländer",
          "description": "",
          "expression": "100000.0 * SUM(unfaelle) / MAX(einwohner) / COUNT(DISTINCT jahr)"
        }
      ]
    }
  ],
